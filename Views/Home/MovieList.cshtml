@model List<Mission6.Models.Movie>

@{
    ViewData["Title"] = "Movie Collection";
}

<div class="text-center">
    <h1 class="display-4">Joel Hilton's Movie Collection</h1>
</div>

<!-- Table to display movies -->
<table class="table table-striped table-bordered mt-4">
    <thead class="table-dark">
    <tr>
        <th>Category</th> <!-- Changed from CategoryId -->
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>Lent To</th>
        <th>Notes</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@(movie.Category != null ? movie.Category.CategoryName : "Unknown")</td> <!-- Show category name -->
            <td>@movie.Title</td>
            <td>@movie.Year</td>
            <td>@movie.Director</td>
            <td>@movie.Rating</td>
            <td>@(movie.Edited.HasValue ? (movie.Edited.Value ? "Yes" : "No") : "N/A")</td>
            <td>@movie.LentTo</td>
            <td>@movie.Notes</td>
            <td>
                <a href="/Home/EditMovie?id=@movie.MovieId" class="btn btn-sm btn-warning">✏️ Edit</a>
                <form method="post" action="/Home/DeleteMovie" onsubmit="return confirm('Are you sure you want to delete this movie?');" style="display:inline;">
                    <input type="hidden" name="id" value="@movie.MovieId" />
                    <button type="submit" class="btn btn-sm btn-danger">🗑️ Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>

</table>
